# Copy to backend/.env for local development (never commit backend/.env).
# See backend/docs/LOCAL_SUPABASE.md for how to get these values from
# `npx supabase start`.

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Local API port. The frontend's VITE_API_BASE_URL should point at
# http://localhost:<BACKEND_PORT>/api/v1.
BACKEND_PORT=3000

# Origin allowed to call this API (the Vite dev server by default).
CORS_ORIGIN=http://localhost:5173

# How often SSE stream endpoints poll the database for new rows.
SSE_POLL_INTERVAL_MS=3000

# Shared secret devices/simulators send as `X-Device-Key` when calling
# POST /devices/:id/readings. Any string works locally — this is a
# placeholder ingestion auth mechanism, not the real device-auth decision
# (docs/PENDING_DECISIONS.md §8).
DEVICE_INGEST_KEY=
